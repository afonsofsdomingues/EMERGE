# Copy to `.env` (git-ignored) and fill in what you need.  Every `emerge`
# command loads this file automatically; real environment variables win over
# entries here.

# Where all outputs land (registry, runs, artifacts, generations, cache).
# Default if unset: ./runs
EMERGE_ROOT=/path/to/experiments

# Only needed for the OpenAI judge (`judges=[{backend: openai, ...}]`).
OPENAI_API_KEY=

# Only needed for gated HuggingFace models (e.g. Llama).
HF_TOKEN=

# Only needed with logging.use_wandb=true (or run `wandb login` once instead).
# WANDB_API_KEY=

# Where Hydra writes its per-invocation logs.  Default: ./outputs
# EMERGE_HYDRA_DIR=
